# Ezekiel Docs - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://ezekieldocs.com
NEXT_PUBLIC_SITE_NAME=Ezekiel Docs

# ===========================================
# Authentication (NextAuth)
# ===========================================
NEXTAUTH_URL=https://ezekieldocs.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ===========================================
# reCAPTCHA (Google)
# Get keys from: https://www.google.com/recaptcha/admin
# ===========================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key-here
RECAPTCHA_SECRET_KEY=your-secret-key-here

# ===========================================
# Vercel Blob Storage (for PDF storage)
# Get token from: https://vercel.com/dashboard/stores
# ===========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here

# ===========================================
# Email (SMTP) - For sending documents & enquiries
# Use: SendGrid, Mailgun, Postmark, or your own SMTP
# ===========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@ezekieldocs.com
ENQUIRY_TO=legal@ezekieldocs.com

# ===========================================
# Payment (Optional - for future use)
# ===========================================
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ===========================================
# Analytics (Optional)
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_ENABLE_VOICE_TOUR=true
NEXT_PUBLIC_ENABLE_WHATSAPP=true